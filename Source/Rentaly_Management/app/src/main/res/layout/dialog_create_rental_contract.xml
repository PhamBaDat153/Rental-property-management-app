<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingTop="4dp" android:paddingEnd="24dp" android:paddingBottom="8dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nhập thông tin hợp đồng thuê" android:textColor="@color/secondary" android:textSize="14sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Phòng *" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <Spinner android:id="@+id/contract_room" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Ngày bắt đầu *" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <EditText android:id="@+id/contract_start" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/edittext_background" android:hint="yyyy-MM-dd" android:inputType="date" android:minHeight="48dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:textColor="@color/dark_navy" android:textColorHint="@color/secondary" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Ngày kết thúc" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <EditText android:id="@+id/contract_end" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/edittext_background" android:hint="yyyy-MM-dd" android:inputType="date" android:minHeight="48dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:textColor="@color/dark_navy" android:textColorHint="@color/secondary" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Giá thuê mỗi tháng *" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <EditText android:id="@+id/contract_rent" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/edittext_background" android:inputType="numberDecimal" android:minHeight="48dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:textColor="@color/dark_navy" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Tiền đặt cọc *" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <EditText android:id="@+id/contract_deposit" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/edittext_background" android:inputType="numberDecimal" android:minHeight="48dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:textColor="@color/dark_navy" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Ngày thanh toán hàng tháng (1-31)" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <EditText android:id="@+id/contract_billing_day" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/edittext_background" android:inputType="number" android:minHeight="48dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:textColor="@color/dark_navy" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Số ngày đến hạn thanh toán *" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <EditText android:id="@+id/contract_due_days" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/edittext_background" android:inputType="number" android:minHeight="48dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:textColor="@color/dark_navy" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Trạng thái" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <RadioGroup android:id="@+id/contract_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal"><RadioButton android:id="@+id/contract_status_active" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Đang hoạt động" /><RadioButton android:id="@+id/contract_status_inactive" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Không hoạt động" /></RadioGroup>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Điều khoản" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <EditText android:id="@+id/contract_terms" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/edittext_background" android:gravity="top" android:inputType="textMultiLine" android:minHeight="80dp" android:padding="12dp" android:textColor="@color/dark_navy" />
        <Button android:id="@+id/contract_choose_pdf" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="16dp" android:backgroundTint="@color/primary" android:text="Chọn file PDF hoặc DOCX" android:textColor="@color/white" />
        <TextView android:id="@+id/contract_pdf_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Chưa chọn tài liệu mới" android:textColor="@color/secondary" />
    </LinearLayout>
</ScrollView>
