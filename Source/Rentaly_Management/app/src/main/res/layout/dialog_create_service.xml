<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingTop="4dp" android:paddingEnd="24dp" android:paddingBottom="8dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Khai báo thông tin và đơn giá mặc định của dịch vụ." android:textColor="@color/secondary" android:textSize="14sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Tên dịch vụ *" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <EditText android:id="@+id/service_form_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/user_detail_card" android:hint="Ví dụ: Điện sinh hoạt" android:minHeight="48dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:singleLine="true" android:textColor="@color/dark_navy" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Đơn vị tính *" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <EditText android:id="@+id/service_form_unit" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/user_detail_card" android:hint="Ví dụ: kWh, m³, tháng" android:minHeight="48dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:singleLine="true" android:textColor="@color/dark_navy" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Cách tính *" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <EditText android:id="@+id/service_form_calculation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/user_detail_card" android:hint="Ví dụ: Theo số lượng sử dụng" android:minHeight="48dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:singleLine="true" android:textColor="@color/dark_navy" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Đơn giá mặc định *" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <EditText android:id="@+id/service_form_price" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/user_detail_card" android:inputType="numberDecimal" android:minHeight="48dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:textColor="@color/dark_navy" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Trạng thái" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <RadioGroup android:id="@+id/service_form_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <RadioButton android:id="@+id/service_form_available" android:layout_width="match_parent" android:layout_height="48dp" android:text="Đang khả dụng" android:textColor="@color/dark_navy" />
            <RadioButton android:id="@+id/service_form_unavailable" android:layout_width="match_parent" android:layout_height="48dp" android:text="Không khả dụng" android:textColor="@color/dark_navy" />
        </RadioGroup>
    </LinearLayout>
</ScrollView>
