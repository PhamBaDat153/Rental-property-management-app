<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Giấy tờ định danh"
        android:textColor="@color/primary"
        android:textSize="18sp"
        android:textStyle="bold" />
    <TextView android:id="@+id/user_identity_type" style="@style/UserDetailValue" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/user_identity_number" style="@style/UserDetailValue" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/user_identity_issued_date" style="@style/UserDetailValue" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/user_identity_issued_place" style="@style/UserDetailValue" android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout>
