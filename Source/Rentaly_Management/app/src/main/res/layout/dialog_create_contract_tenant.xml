<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingTop="4dp" android:paddingEnd="24dp" android:paddingBottom="8dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nhập thông tin người thuê trong hợp đồng" android:textColor="@color/secondary" android:textSize="14sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Người thuê" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <Spinner android:id="@+id/contract_tenant_form_tenant" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Ngày vào ở" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <EditText android:id="@+id/contract_tenant_form_move_in" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/edittext_background" android:focusable="false" android:hint="yyyy-MM-dd" android:inputType="date" android:minHeight="48dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:textColor="@color/dark_navy" android:textColorHint="@color/secondary" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Ngày rời đi" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <EditText android:id="@+id/contract_tenant_form_move_out" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/edittext_background" android:focusable="false" android:hint="yyyy-MM-dd" android:inputType="date" android:minHeight="48dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:textColor="@color/dark_navy" android:textColorHint="@color/secondary" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Vai trò trong hợp đồng" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <RadioGroup android:id="@+id/contract_tenant_form_representative" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"><RadioButton android:id="@+id/contract_tenant_form_yes" android:layout_width="match_parent" android:layout_height="48dp" android:text="Người đại diện" /><RadioButton android:id="@+id/contract_tenant_form_no" android:layout_width="match_parent" android:layout_height="48dp" android:text="Không đại diện" /></RadioGroup>
    </LinearLayout>
</ScrollView>
