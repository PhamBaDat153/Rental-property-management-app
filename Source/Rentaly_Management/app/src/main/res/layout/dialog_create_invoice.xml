<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true">
    <LinearLayout android:id="@+id/invoice_form" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingTop="4dp" android:paddingEnd="24dp" android:paddingBottom="8dp">
        <LinearLayout android:id="@+id/invoice_form_create_fields" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tiền thuê được lấy từ hợp đồng. Các khoản dưới đây chỉ là dịch vụ bổ sung." android:textColor="@color/secondary" android:textSize="14sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Hợp đồng *" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <Spinner android:id="@+id/invoice_form_contract" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Số hóa đơn *" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <EditText android:id="@+id/invoice_form_number" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/user_detail_card" android:hint="Nhập số hóa đơn" android:minHeight="48dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:singleLine="true" android:textColor="@color/dark_navy" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Các khoản trong hóa đơn" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <LinearLayout android:id="@+id/invoice_form_items" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/user_detail_card" android:orientation="vertical" android:padding="12dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Tạm tính" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/invoice_form_subtotal" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:background="@drawable/user_detail_card" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="0 VND" android:textColor="@color/dark_navy" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Giảm giá (VND)" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <EditText android:id="@+id/invoice_form_discount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/user_detail_card" android:hint="0" android:inputType="numberDecimal" android:minHeight="48dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:textColor="@color/dark_navy" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Thuế suất" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <Spinner android:id="@+id/invoice_form_tax_rate" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Tiền thuế" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/invoice_form_tax_amount" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:background="@drawable/user_detail_card" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="0 VND" android:textColor="@color/dark_navy" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Tổng cộng" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/invoice_form_total" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:background="@drawable/user_detail_card" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="0 VND" android:textColor="@color/dark_navy" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Hạn thanh toán" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <EditText android:id="@+id/invoice_form_due" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/user_detail_card" android:focusable="false" android:hint="Chọn ngày thanh toán" android:minHeight="48dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:textColor="@color/dark_navy" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Trạng thái" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <Spinner android:id="@+id/invoice_form_status" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" />
    </LinearLayout>
</ScrollView>
