        <TextView android:id="@+id/invoice_item_number" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/dark_navy" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/invoice_item_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/secondary" android:textSize="14sp" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="48dp" android:contentDescription="Mở chi tiết hóa đơn" android:gravity="center" android:text="›" android:textColor="@color/secondary" android:textSize="28sp" />
</LinearLayout>
