<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/user_detail_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quay về" />

        <TextView
            android:id="@+id/user_detail_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/user_detail_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/dark_navy"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Role"
            android:textColor="@color/primary"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/user_detail_role"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton android:id="@+id/role_tenant" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TENANT" />
            <RadioButton android:id="@+id/role_landlord" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LANDLORD" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Trạng thái"
            android:textColor="@color/primary"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/user_detail_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton android:id="@+id/status_active" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Đang hoạt động" />
            <RadioButton android:id="@+id/status_inactive" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Không hoạt động" />
        </RadioGroup>

        <Button
            android:id="@+id/user_detail_update"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/primary"
            android:text="Cập nhật" />

        <Button
            android:id="@+id/user_detail_delete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Xóa người dùng" />
    </LinearLayout>
</ScrollView>
