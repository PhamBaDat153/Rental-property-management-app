<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingTop="4dp" android:paddingEnd="24dp" android:paddingBottom="8dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nhập số liệu thực tế và ảnh chứng minh nếu cần đối soát." android:textColor="@color/secondary" android:textSize="14sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Ngày giờ đọc chỉ số" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <EditText android:id="@+id/reading_form_at" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/user_detail_card" android:inputType="text" android:minHeight="48dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:textColor="@color/dark_navy" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Chỉ số trước" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <EditText android:id="@+id/reading_form_previous" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/user_detail_card" android:inputType="numberDecimal" android:minHeight="48dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:textColor="@color/dark_navy" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Chỉ số hiện tại" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <EditText android:id="@+id/reading_form_current" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/user_detail_card" android:inputType="numberDecimal" android:minHeight="48dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:textColor="@color/dark_navy" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Lượng tiêu thụ" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <EditText android:id="@+id/reading_form_quantity" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/user_detail_card" android:inputType="numberDecimal" android:minHeight="48dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:textColor="@color/dark_navy" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Ảnh chứng minh" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <Button android:id="@+id/reading_form_evidence" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:backgroundTint="@color/secondary" android:text="Chọn file ảnh" android:textColor="@color/white" />
        <ImageView android:id="@+id/reading_form_preview" android:layout_width="match_parent" android:layout_height="160dp" android:layout_marginTop="8dp" android:contentDescription="Ảnh chứng minh chỉ số" android:scaleType="centerCrop" android:visibility="gone" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Ghi chú" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <EditText android:id="@+id/reading_form_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/user_detail_card" android:gravity="top" android:inputType="textMultiLine" android:minHeight="72dp" android:padding="12dp" android:textColor="@color/dark_navy" />
    </LinearLayout>
</ScrollView>
