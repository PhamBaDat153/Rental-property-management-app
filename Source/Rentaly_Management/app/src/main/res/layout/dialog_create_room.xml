<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingTop="4dp" android:paddingEnd="24dp" android:paddingBottom="8dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nhập thông tin phòng và tiện ích" android:textColor="@color/secondary" android:textSize="14sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Địa điểm" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <Spinner android:id="@+id/room_location" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Mã phòng" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <EditText android:id="@+id/room_code" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/edittext_background" android:hint="Nhập mã phòng *" android:inputType="text" android:minHeight="48dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:singleLine="true" android:textColor="@color/dark_navy" android:textColorHint="@color/secondary" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Tên phòng" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <EditText android:id="@+id/room_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/edittext_background" android:hint="Nhập tên phòng" android:inputType="text" android:minHeight="48dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:singleLine="true" android:textColor="@color/dark_navy" android:textColorHint="@color/secondary" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Hình ảnh phòng" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <Button android:id="@+id/room_choose_images" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:backgroundTint="@color/primary" android:text="Chọn hình ảnh (tối đa 6)" android:textColor="@color/white" />
        <TextView android:id="@+id/room_images_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Chưa chọn hình ảnh" android:textColor="@color/secondary" />
        <LinearLayout android:id="@+id/room_image_preview" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Số tầng của phòng" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <EditText android:id="@+id/room_floor" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/edittext_background" android:hint="Nhập số tầng" android:inputType="number" android:minHeight="48dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:textColor="@color/dark_navy" android:textColorHint="@color/secondary" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Diện tích phòng (m²)" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <EditText android:id="@+id/room_area" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/edittext_background" android:hint="Nhập diện tích" android:inputType="numberDecimal" android:minHeight="48dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:textColor="@color/dark_navy" android:textColorHint="@color/secondary" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Số người tối đa" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <EditText android:id="@+id/room_occupants" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/edittext_background" android:hint="Nhập số người tối đa *" android:inputType="number" android:minHeight="48dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:textColor="@color/dark_navy" android:textColorHint="@color/secondary" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Giá mặc định" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <EditText android:id="@+id/room_rent" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/edittext_background" android:hint="Giá thuê/tháng *" android:inputType="numberDecimal" android:minHeight="48dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:textColor="@color/dark_navy" android:textColorHint="@color/secondary" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Trạng thái phòng" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <RadioGroup android:id="@+id/room_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal"><RadioButton android:id="@+id/room_status_available" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Đang khả dụng" /><RadioButton android:id="@+id/room_status_unavailable" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Không khả dụng" /></RadioGroup>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Mô tả phòng" android:textColor="@color/dark_navy" android:textSize="14sp" android:textStyle="bold" />
        <EditText android:id="@+id/room_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/edittext_background" android:gravity="top" android:hint="Nhập mô tả nếu có" android:inputType="textMultiLine" android:minHeight="72dp" android:padding="12dp" android:textColor="@color/dark_navy" android:textColorHint="@color/secondary" />
    </LinearLayout>
</ScrollView>
