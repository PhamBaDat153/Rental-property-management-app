<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@color/background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><Button android:id="@+id/maintenance_back" android:layout_width="48dp" android:layout_height="48dp" android:backgroundTint="@color/primary" android:contentDescription="Quay lại" android:drawableStart="@drawable/back_icon" android:minWidth="0dp" android:minHeight="0dp" android:padding="8dp" android:text=""/><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="16dp" android:text="Bảo trì" android:textColor="@color/dark_navy" android:textSize="24sp" android:textStyle="bold"/></LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/user_detail_card" android:padding="16dp" android:text="Danh sách yêu cầu bảo trì chỉ được xem trong ứng dụng." android:textColor="@color/secondary" android:textSize="14sp"/>
    <ProgressBar android:id="@+id/maintenance_loading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:visibility="gone"/>
    <TextView android:id="@+id/maintenance_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:gravity="center" android:text="Chưa có yêu cầu bảo trì" android:textColor="@color/secondary" android:visibility="gone"/>
    <ListView android:id="@+id/maintenance_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp" android:divider="@color/background" android:dividerHeight="8dp"/>
</LinearLayout>
