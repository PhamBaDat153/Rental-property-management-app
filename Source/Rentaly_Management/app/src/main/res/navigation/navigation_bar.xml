<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navigation_bar"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.android_dev.rentaly_management.Fragment.ScreenFragment"
        android:label="Trang chủ">
        <argument android:name="screen_title" android:defaultValue="Trang chủ" />
    </fragment>

    <fragment
        android:id="@+id/propertiesFragment"
        android:name="com.android_dev.rentaly_management.Fragment.PropertiesFragment"
        android:label="Phòng trọ">
        <argument android:name="screen_title" android:defaultValue="Phòng trọ" />
    </fragment>

    <fragment
        android:id="@+id/contractsFragment"
        android:name="com.android_dev.rentaly_management.Fragment.ScreenFragment"
        android:label="Hợp đồng">
        <argument android:name="screen_title" android:defaultValue="Hợp đồng" />
    </fragment>

    <fragment
        android:id="@+id/profilesFragment"
        android:name="com.android_dev.rentaly_management.Fragment.UserManageFragment"
        android:label="Cá nhân">
        <argument android:name="screen_title" android:defaultValue="Cá nhân" />
    </fragment>

    <fragment
        android:id="@+id/userDetailFragment"
        android:name="com.android_dev.rentaly_management.Fragment.UserDetailFragment"
        android:label="Chi tiết người dùng">
        <argument
            android:name="user_id"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/locationDetailFragment"
        android:name="com.android_dev.rentaly_management.Fragment.LocationDetailFragment"
        android:label="Chi tiết địa điểm">
        <argument android:name="location_id" app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/roomDetailFragment"
        android:name="com.android_dev.rentaly_management.Fragment.RoomDetailFragment"
        android:label="Chi tiết phòng">
        <argument android:name="room_id" app:argType="string" />
    </fragment>

</navigation>
